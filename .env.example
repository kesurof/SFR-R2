# ------------------------------------------------------------------
# Application — configuration. Copier en `.env` et renseigner chaque valeur.
# Ne jamais commiter le fichier `.env`.
# ------------------------------------------------------------------

# Base SQLite (fichier sur le volume persistant monté dans /data)
DATABASE_URL="file:/data/sfr.db"

# Auth.js — secret de session. Générer : openssl rand -base64 32
AUTH_SECRET=""

# Application OAuth2 Discord (portail développeur Discord)
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# Serveur Discord de référence (clic droit sur le serveur → Copier l'identifiant)
DISCORD_GUILD_ID=""

# Token du bot (onglet Bot de la même application ; intent "Server Members" uniquement)
DISCORD_BOT_TOKEN=""

# IDs Discord des administrateurs, séparés par des virgules
ADMIN_DISCORD_IDS=""

# Chiffrement des clés stockées — 32 octets en base64. Générer : openssl rand -base64 32
ENCRYPTION_KEY=""

# URL publique de l'instance (https en production).
# La redirect OAuth Discord doit être : <NEXTAUTH_URL>/api/auth/callback/discord
NEXTAUTH_URL="https://app.example.com"

# Laisser à true derrière un reverse proxy (Docker, Coolify, Traefik…)
AUTH_TRUST_HOST="true"

# ---- Optionnel ----

# Tag de l'image Docker utilisée par `docker-compose.yml`.
# Laisser vide en production (=> `latest`). Mettre `dev` pour l'environnement de test.
# SFR_IMAGE_TAG="dev"

# Lien d'invitation affiché aux comptes connectés hors serveur
# DISCORD_INVITE_URL="https://discord.gg/xxxxxxx"

# true si un reverse proxy renseigne X-Forwarded-For (rate-limiting du claim)
# TRUST_PROXY="false"

# Fenêtre et quotas de rate-limiting (valeurs par défaut ci-dessous)
# RATE_LIMIT_WINDOW_SECONDS="900"
# RATE_LIMIT_CLAIM_CREATE_MAX="5"
# RATE_LIMIT_CLAIM_CONSUME_MAX="10"

# Notifications Discord (DM et webhook configuré dans l'administration), utilisées à la première initialisation
DISCORD_NOTIFICATIONS_ENABLED="true"
NOTIFICATION_WORKER_INTERVAL_SECONDS="30"
