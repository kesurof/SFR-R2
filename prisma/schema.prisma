generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String                @id @default(cuid())
  discordId        String                @unique
  username         String
  serverNickname   String?
  discordRoles     String                @default("[]")
  joinedAt         DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  sponsorPermission SponsorPermission?
  accessApproverPermission AccessApproverPermission?
  sponsoredRequests SponsorshipRequest[] @relation("Sponsor")
  referredRequests  SponsorshipRequest[] @relation("Referred")
  accessRequests    AccessRequest[]
  accessKeys        AccessKey[]
}

model SyncState {
  id              String   @id
  status          String   @default("IDLE")
  startedAt       DateTime?
  completedAt     DateTime?
  memberCount     Int      @default(0)
  errorMessage    String?
  updatedAt       DateTime @updatedAt
}

model AppSettings {
  id                              String   @id @default("global")
  discordNotificationsEnabled    Boolean  @default(true)
  notificationWorkerIntervalSeconds Int    @default(30)
  accessRequestChannelId            String?
  updatedAt                       DateTime @updatedAt
  updatedByDiscordId              String?
}

model DiscordNotification {
  id                 String   @id @default(cuid())
  type               String
  targetId           String
  targetKind         String   @default("DM")
  requestId          String?
  accessRequestId    String?
  keyId              String?
  dedupeKey          String   @unique
  message            String   @default("")
  status             String   @default("PENDING")
  attempts           Int      @default(0)
  lastErrorCode      String?
  nextAttemptAt      DateTime?
  sentAt             DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  @@index([status, nextAttemptAt])
  @@index([requestId])
  @@index([accessRequestId])
}

model SponsorPermission {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  grantedByDiscordId String
  createdAt          DateTime @default(now())
}

model AccessApproverPermission {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  grantedByDiscordId String
  createdAt          DateTime @default(now())
}

model AccessRequest {
  id                    String   @id @default(cuid())
  requesterId           String
  requester             User     @relation(fields: [requesterId], references: [id])
  communitiesAndTrackers String
  motivations           String
  selfHostingExperience String
  discoverySource       String?
  status                String   @default("PENDING")
  decidedByDiscordId    String?
  decidedAt             DateTime?
  decisionComment       String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([status])
  @@index([requesterId])
}

model SponsorshipRequest {
  id                String   @id @default(cuid())
  sponsorId         String
  sponsor           User     @relation("Sponsor", fields: [sponsorId], references: [id])
  referredId        String
  referred          User     @relation("Referred", fields: [referredId], references: [id])
  relationship      String
  knownSince        String
  context           String
  comment           String?
  attestationAccepted Boolean  @default(false)
  attestationAcceptedAt DateTime?
  status            String   @default("PENDING")
  decidedByDiscordId String?
  decidedAt         DateTime?
  rejectionReason   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status])
  @@index([referredId])
}

model AccessKey {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id])
  encryptedSecret String
  secretHash      String
  prefix          String
  suffix          String
  status          String       @default("ACTIVE")
  revokedAt       DateTime?
  createdAt       DateTime     @default(now())
  claims          ClaimToken[]

  @@index([userId, status])
}

model ClaimToken {
  id        String    @id @default(cuid())
  keyId     String
  key       AccessKey @relation(fields: [keyId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  claimedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([expiresAt, claimedAt])
}

model AuditLog {
  id              String   @id @default(cuid())
  event           String
  actorDiscordId  String?
  targetDiscordId String?
  requestId       String?
  keyId           String?
  metadata        String   @default("{}")
  createdAt       DateTime @default(now())

  @@index([event])
}
